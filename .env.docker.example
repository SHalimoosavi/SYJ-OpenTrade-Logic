# Copy to .env.docker and fill in real values before running:
#   docker compose --env-file .env.docker up --build

# REQUIRED. Generate a real random secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real secret to git or reuse this example value.
SYJ_SECRET_KEY=

# Optional: defaults to a local SQLite file inside the container's data volume.
# For a real production deployment, point this at a real Postgres instance:
#   SYJ_DATABASE_URL=postgresql://user:password@host:5432/dbname
SYJ_DATABASE_URL=sqlite:////app/data/syj_opentrade.db

# The public URL the DASHBOARD will use to reach the API -- this gets baked
# into the frontend's JS bundle at build time (see Dockerfile.frontend).
# For local testing, http://localhost:8000 is fine. For a real deployment,
# use your actual public API URL, e.g. https://api.yourdomain.com
SYJ_PUBLIC_API_URL=http://localhost:8000
